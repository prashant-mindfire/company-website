# Next.js runtime
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Strapi CMS
CMS_URL=http://localhost:1337

# Create a read/write API token in Strapi's admin panel.
# This variable is server-only and must not use the NEXT_PUBLIC_ prefix.
CMS_API_TOKEN=replace-with-your-strapi-api-token
